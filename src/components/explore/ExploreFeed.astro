---
// Feed do Explore (trending, busca e grade com scroll infinito).
// Os filtros (categoria, streamings, esconder o que já está nas listas) vêm do botão de filtro da navbar.
import AddStatusButton from '../titles/AddStatusButton.astro';
---

	<section class="explore" aria-labelledby="explore-title">
		<h2 id="explore-title" class="section-title">Find new content</h2>

		<div id="explore-status" class="explore-status" role="status" hidden>
			<p id="explore-status-text"></p>
			<button type="button" id="explore-status-action" hidden></button>
		</div>

		<div id="explore-grid" class="explore-grid" aria-live="polite">
			<div id="explore-sentinel" class="explore-sentinel" aria-hidden="true"></div>
		</div>
	</section>

	<!-- Modelo de card: clonado pelo script para cada título retornado. -->
	<template id="card-template">
		<article class="title-card">
			<div class="title-card__media" aria-hidden="true"><img class="title-card__backdrop" alt="" decoding="async" /><div class="title-card__blur"><img alt="" decoding="async" /></div></div>
			<a class="title-card__cover" href="/"></a>
			<div class="title-card__info">
				<img class="title-card__poster" alt="" loading="lazy" decoding="async" hidden />
				<div class="title-card__text">
					<span class="title-card__status" hidden></span>
					<h2 class="title-card__title"></h2>
					<p class="title-card__meta"></p>
				</div>
			</div>
			<div class="title-card__providers" hidden></div>
			<AddStatusButton tmdbId={0} mediaType="movie" title="" posterPath={null} />
		</article>
	</template>

	<script>
		import { supabase } from '../../lib/supabase.js';
		import { apiFetch } from '../../lib/api';
		import { initAddStatus } from '../../lib/lists/add-status';
		import { posterUrl } from '../../lib/tmdb/images';
		import { backdropUrl, setCardBackdrop } from '../../lib/tmdb/card-image';
		import { writeCardSummary } from '../../lib/tmdb/card-cache';
		import { setCardMeta, setCardProviders, setCardStatus } from '../../lib/tmdb/format';
		import { setSearchOpen, setSearchQuery } from '../../lib/ui/search';
		import { filtersEqual, FILTERS_EVENT, getFilters, setFilters } from '../../lib/ui/explore-filters';
		import type { ExploreFilters } from '../../lib/ui/explore-filters';
		import { getListedTitleKeys, getUserStreamings } from '../../lib/lists/store';
		import { brandName } from '../../lib/streaming/canonical';
		import { isReturningVisit, loadScreenState, onLeave, saveScreenState } from '../../lib/ui/navigation';

		type Item = {
			id: number;
			mediaType: 'movie' | 'tv';
			title: string;
			posterPath: string | null;
			backdropPath: string | null;
			voteAverage: number;
			runtime?: number | null;
			genre?: string | null;
			status?: string;
			seasons?: number;
			year?: number | null;
			lastSeasonYear?: number | null;
			providers?: { name: string; logoPath: string | null }[];
		};

		const STATE_KEY = 'aurora:explore';

		// A navegação troca a página sem recarregar o script, então a tela é montada a cada visita.
		let currentSave: () => void = () => {};
		let observer: IntersectionObserver | null = null;
		let removeHeaderSearch: (() => void) | null = null;
		let removeFilterListener: (() => void) | null = null;

		onLeave(() => currentSave());

		const setupExplore = async () => {
		const grid = document.getElementById('explore-grid') as HTMLDivElement;
		const cardTemplate = document.getElementById('card-template') as HTMLTemplateElement;
		const sentinel = document.getElementById('explore-sentinel') as HTMLDivElement;
		const statusBox = document.getElementById('explore-status') as HTMLDivElement;
		const statusText = document.getElementById('explore-status-text') as HTMLParagraphElement;
		const statusAction = document.getElementById('explore-status-action') as HTMLButtonElement;

		const state = {
			filters: getFilters(),
			query: '',
			page: 0,
			totalPages: 0,
			items: [] as Item[],
			loading: false,
			requestId: 0,
			// Falhou: não repete sozinho até o usuário tentar de novo.
			failed: false,
		};

		const emptyMessage = () =>
			state.query ? `No results for "${state.query}".` : 'Nothing to show here right now.';

		const showStatus = (message: string | null, action?: { label: string; run: () => void }) => {
			statusBox.hidden = !message;
			statusText.textContent = message ?? '';
			statusAction.hidden = !action;
			if (action) {
				statusAction.textContent = action.label;
				statusAction.onclick = action.run;
			}
		};

		const clearCards = () => {
			grid.querySelectorAll('.title-card, .explore-skeleton').forEach((node) => node.remove());
		};

		const addSkeletons = (count: number) => {
			for (let index = 0; index < count; index++) {
				const skeleton = document.createElement('div');
				skeleton.className = 'explore-skeleton';
				skeleton.setAttribute('aria-hidden', 'true');
				grid.append(skeleton);
			}
		};

		const clearSkeletons = () => {
			grid.querySelectorAll('.explore-skeleton').forEach((node) => node.remove());
		};

		const makeCard = (item: Item) => {
			const node = cardTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
			const cover = node.querySelector<HTMLAnchorElement>('.title-card__cover')!;
			cover.href = `/title/${item.mediaType}/${item.id}`;
			cover.setAttribute('aria-label', item.title);

			// Fundo: backdrop do título (fixo, sempre o mesmo arquivo); sem backdrop, usa o pôster.
			// Os primeiros cards carregam já; os demais, quando chegam perto da tela.
			const eager = grid.querySelectorAll('.title-card').length < 6;
			setCardBackdrop(node, backdropUrl(item.backdropPath, item.posterPath), eager);

			// Guarda os dados do card: a tela de listas usa o mesmo cache e pinta na hora.
			writeCardSummary(item.mediaType, item.id, {
				backdropPath: item.backdropPath,
				voteAverage: item.voteAverage,
				runtime: item.runtime ?? null,
				genre: item.genre ?? null,
				status: item.status ?? '',
				seasons: item.seasons ?? 0,
				year: item.year ?? null,
				lastSeasonYear: item.lastSeasonYear ?? null,
				providers: item.providers ?? [],
			});

			const poster = node.querySelector<HTMLImageElement>('.title-card__poster')!;
			const posterSrc = posterUrl(item.posterPath, 'w185');
			if (posterSrc) {
				poster.src = posterSrc;
				poster.hidden = false;
			}

			node.querySelector<HTMLElement>('.title-card__title')!.textContent = item.title;
			setCardMeta(node.querySelector<HTMLElement>('.title-card__meta')!, item);
			setCardStatus(node.querySelector<HTMLElement>('.title-card__status')!, item.mediaType, item.status);
			setCardProviders(node.querySelector<HTMLElement>('.title-card__providers')!, item.providers);

			const root = node.querySelector<HTMLElement>('[data-add-status]')!;
			root.dataset.tmdbId = String(item.id);
			root.dataset.mediaType = item.mediaType;
			root.dataset.title = item.title;
			root.dataset.posterPath = item.posterPath ?? '';

			return { node, root };
		};

		const renderItems = (items: Item[]) => {
			for (const item of items) {
				const { node, root } = makeCard(item);
				grid.insertBefore(node, sentinel);
				void initAddStatus(root);
			}
		};

		const loadNext = async () => {
			if (state.loading || state.failed) return;
			if (state.page > 0 && state.page >= state.totalPages) return;

			const requestId = state.requestId;
			state.loading = true;
			showStatus(null);
			addSkeletons(state.page === 0 ? 12 : 6);

			try {
				const { filters } = state;
				const params = new URLSearchParams({ page: String(state.page + 1) });
				if (state.query) {
					params.set('tab', 'search');
					params.set('q', state.query);
				} else {
					params.set('tab', 'trending');
				}
				if (filters.category !== 'all') params.set('category', filters.category);

				// "Just mine": só títulos nos streamings do usuário (por marca, ex.: "HBO Max").
				if (filters.streamings === 'mine') {
					const brands = [...new Set((await getUserStreamings()).map((row) => brandName(row.providerName)))];
					if (requestId !== state.requestId) return;
					if (brands.length === 0) {
						showStatus('You have not picked any streamings yet. Add them in your account menu.');
						state.totalPages = 1;
						state.page = 1;
						return;
					}
					params.set('providers', brands.join(','));
				}

				const listed = filters.hideListed ? await getListedTitleKeys() : null;

				const response = await apiFetch(`/api/explore?${params}`);
				if (!response.ok) throw new Error(`explore ${response.status}`);
				const data = (await response.json()) as { items: Item[]; totalPages: number };

				// Resposta de uma busca ou filtro anterior: descarta.
				if (requestId !== state.requestId) return;

				// "Hide content from lists": tira o que já está em alguma lista do usuário.
				const visible = listed ? data.items.filter((item) => !listed.has(`${item.mediaType}:${item.id}`)) : data.items;

				state.page += 1;
				state.totalPages = data.totalPages;
				state.items.push(...visible);
				renderItems(visible);

				if (state.items.length === 0 && state.page >= state.totalPages) {
					showStatus(emptyMessage());
				}
			} catch (error) {
				if (requestId !== state.requestId) return;
				console.error(error);
				state.failed = true;
				showStatus('We could not load titles. Try again.', {
					label: 'Try again',
					run: () => {
						state.failed = false;
						void loadNext();
					},
				});
			} finally {
				if (requestId === state.requestId) {
					state.loading = false;
					clearSkeletons();
					// Se o final da grid continuar visível (tela alta), carrega mais uma página.
					requestAnimationFrame(() => {
						if (sentinel.getBoundingClientRect().top < window.innerHeight + 400) {
							void loadNext();
						}
					});
				}
			}
		};

		// Nova busca ou novo filtro: recomeça do início.
		const reset = async () => {
			state.requestId += 1;
			state.page = 0;
			state.totalPages = 0;
			state.loading = false;
			state.failed = false;
			state.items = [];
			clearCards();
			await loadNext();
		};

		type ScreenState = {
			filters?: ExploreFilters;
			query: string;
			page: number;
			totalPages: number;
			items: Item[];
			scrollY: number;
		};

		// Volta para a mesma busca e filtros, com os títulos já carregados e a posição da rolagem.
		const restore = (saved: ScreenState) => {
			state.filters = saved.filters ?? getFilters();
			setFilters(state.filters);
			state.query = saved.query;
			state.page = saved.page;
			state.totalPages = saved.totalPages;
			state.items = saved.items;

			setSearchQuery(saved.query);
			if (saved.query && window.matchMedia('(max-width: 767px)').matches) setSearchOpen(true);

			renderItems(saved.items);
			if (saved.items.length === 0) showStatus(emptyMessage());
			requestAnimationFrame(() => window.scrollTo(0, saved.scrollY));
		};

		// Busca com debounce, vinda do campo da navbar (evento aurora:search).
		let searchTimer: number | undefined;
		const scheduleSearch = (raw: string, immediate = false) => {
			window.clearTimeout(searchTimer);
			searchTimer = window.setTimeout(() => {
				const query = raw.trim();
				if (query.length === 1) return; // espera pelo menos 2 caracteres
				if (query === state.query) return;
				state.query = query;
				void reset();
			}, immediate ? 0 : 350);
		};

		// Filtro da navbar mudou: refaz a lista com o novo critério.
		removeFilterListener?.();
		const onFilters = (event: Event) => {
			const next = (event as CustomEvent<ExploreFilters>).detail;
			if (filtersEqual(next, state.filters)) return;
			state.filters = next;
			void reset();
		};
		document.addEventListener(FILTERS_EVENT, onFilters);
		removeFilterListener = () => document.removeEventListener(FILTERS_EVENT, onFilters);

		removeHeaderSearch?.();
		const onHeaderSearch = (event: Event) => {
			const { query, immediate } = (event as CustomEvent<{ query: string; immediate?: boolean }>).detail;
			scheduleSearch(query, immediate);
		};
		document.addEventListener('aurora:search', onHeaderSearch);
		removeHeaderSearch = () => document.removeEventListener('aurora:search', onHeaderSearch);

		// Busca vinda de outra tela (/?q=termo).
		const initialQuery = new URLSearchParams(window.location.search).get('q')?.trim();

		// Scroll infinito: carrega a próxima página quando o final da grid aparece.
		observer?.disconnect();
		observer = new IntersectionObserver((entries) => {
			if (entries.some((entry) => entry.isIntersecting)) {
				void loadNext();
			}
		}, { rootMargin: '400px 0px' });
		observer.observe(sentinel);

		// Ao sair da tela (ex.: abrir um título), guarda aba, busca, itens e posição.
		currentSave = () => {
			// Só salva se o feed está na tela: ao sair de outra página (ex.: o título), não sobrescreve.
			if (!document.getElementById('explore-grid')) return;
			saveScreenState(STATE_KEY, {
				filters: state.filters,
				query: state.query,
				page: state.page,
				totalPages: state.totalPages,
				items: state.items,
				scrollY: window.scrollY,
			});
		};

		// Mesma proteção das outras telas: sem sessão, volta para o login.
		const { data: sessionData } = await supabase.auth.getSession();
		if (!sessionData.session) {
			window.location.replace('/login');
		} else {
			const saved = isReturningVisit() ? loadScreenState<ScreenState>(STATE_KEY) : null;
			if (saved) {
				restore(saved);
			} else if (initialQuery && initialQuery.length > 1) {
				state.query = initialQuery;
				setSearchQuery(initialQuery);
				if (window.matchMedia('(max-width: 767px)').matches) setSearchOpen(true);
				void reset();
			} else {
				void reset();
			}
		}
		};

		document.addEventListener('astro:page-load', () => {
			if (document.getElementById('explore-grid')) void setupExplore();
		});
	</script>

<style is:global>
	.explore {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.explore .sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.explore-status {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		padding: 24px 0;
		text-align: center;
		color: var(--color-text-muted);
	}

	.explore-status button {
		padding: 8px 14px;
		border-radius: 999px;
		border: 1px solid var(--color-border-strong);
		background-color: var(--color-surface-raised);
		color: var(--color-text);
		cursor: pointer;
	}

	/* Cards: 3 colunas no desktop, 2 no tablet e 1 no mobile, com 16px de gap. */
	/* 3 colunas ocupando a largura total (cards crescem mantendo 16:9); 2 no tablet e 1 no mobile. */
	.explore-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
		width: 100%;
	}

	@media (max-width: 1023px) {
		.explore-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 767px) {
		.explore-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.explore-skeleton {
		height: 300px;
		border-radius: 16px;
		background: linear-gradient(90deg, var(--color-surface) 25%, var(--color-surface-hover) 50%, var(--color-surface) 75%);
		background-size: 200% 100%;
		animation: explore-shimmer 1.2s linear infinite;
	}

	@media (max-width: 1023px) {
		.explore-skeleton {
			height: 250px;
		}
	}

	.explore-sentinel {
		grid-column: 1 / -1;
		height: 1px;
	}

	@keyframes explore-shimmer {
		from {
			background-position: 200% 0;
		}
		to {
			background-position: -200% 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.explore-skeleton {
			animation: none;
			transition: none;
		}
	}
</style>
