---
// Botão "+ Add" que vira badge verde com dropdown de ajustes.
// Usado em Detalhes do Título, Explore e Lista. O estado vem do Supabase no cliente.
interface Props {
  tmdbId: number;
  mediaType: 'movie' | 'tv';
  title: string;
  posterPath: string | null;
}

const { tmdbId, mediaType, title, posterPath } = Astro.props;
---

<div
  class="add-status"
  data-add-status
  data-tmdb-id={tmdbId}
  data-media-type={mediaType}
  data-title={title}
  data-poster-path={posterPath ?? ''}
>
  <button type="button" class="add-button" data-add hidden>
    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" /></svg>
    <span>Add</span>
  </button>
  <button type="button" class="status-badge" data-badge hidden aria-haspopup="dialog" aria-label={`${title} is in your lists. Open options`}>
    <span class="status-badge__check">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
    </span>
    <span class="status-badge__label" data-badge-label aria-hidden="true"></span>
  </button>
  <dialog class="popover" data-menu aria-label={`Options for ${title}`}>
    <div class="menu" data-menu-items></div>
  </dialog>
</div>

<style>
  .add-status {
    display: inline-flex;
  }

  .add-button,
  /* Badge: bolinha verde com o check. */
  .status-badge {
    display: inline-flex;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
  }

  .status-badge__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-added);
  }

  /* O nome da lista só existe nos cards (ver abaixo). */
  .status-badge__label {
    display: none;
  }

  .status-badge.is-entering {
    animation: badge-in 260ms ease-out;
  }

  /* Nos cards, a bolinha vira uma pílula com o nome da lista:
     expande (e mostra o nome com fade) com o mouse sobre a bolinha ou logo depois de adicionar,
     e volta a ser só a bolinha quando o mouse sai. */
  :global(.title-card) .status-badge {
    --check: 48px;
    --pad: 0px;
    box-sizing: border-box;
    justify-content: flex-start;
    width: 48px;
    padding: var(--pad);
    overflow: hidden;
    border-radius: 999px;
    background-color: transparent;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transition:
      width 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      padding 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 220ms ease;
  }

  :global(.title-card) .status-badge__check {
    width: var(--check);
    height: var(--check);
    transition:
      width 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      height 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  :global(.title-card) .status-badge__label {
    display: block;
    padding-inline: 10px 16px;
    font-size: 1.0625rem;
    line-height: 1;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 160ms ease;
  }

  :global(.title-card) .status-badge:hover,
  :global(.title-card) .status-badge:focus-visible,
  :global(.title-card) .status-badge.is-open {
    --check: 40px;
    --pad: 4px;
    width: var(--expanded-width, auto);
    background-color: #00000066;
  }

  :global(.title-card) .status-badge:hover .status-badge__label,
  :global(.title-card) .status-badge:focus-visible .status-badge__label,
  :global(.title-card) .status-badge.is-open .status-badge__label {
    opacity: 1;
    /* O nome entra um instante depois de a pílula começar a abrir. */
    transition-delay: 90ms;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.title-card) .status-badge,
    :global(.title-card) .status-badge__check,
    :global(.title-card) .status-badge__label {
      transition-duration: 1ms;
    }
  }

  .add-button:disabled,
  .status-badge:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  @keyframes badge-in {
    from {
      transform: scale(0.6);
      opacity: 0;
    }
  }
</style>

<script>
  import { initAddStatus } from '../../lib/lists/add-status';

  // A navegação troca a página sem recarregar o script: inicializa a cada visita.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-add-status]').forEach((root) => {
      void initAddStatus(root);
    });
  });
</script>
