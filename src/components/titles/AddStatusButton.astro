---
import { serverT } from '../../lib/i18n';
// Botão "+ Add" que vira badge verde com dropdown de ajustes.
// Usado em Detalhes do Título, Explore e Lista. O estado vem do Supabase no cliente.
interface Props {
  tmdbId: number;
  mediaType: 'movie' | 'tv';
  title: string;
  posterPath: string | null;
}

const { tmdbId, mediaType, title, posterPath } = Astro.props;
const tr = serverT(Astro.locals);
---

<div
  class="add-status"
  data-add-status
  data-tmdb-id={tmdbId}
  data-media-type={mediaType}
  data-title={title}
  data-poster-path={posterPath ?? ''}
>
  <button type="button" class="add-button" data-add hidden>
    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" /></svg>
    <span>{tr('card.add')}</span>
  </button>
  <button type="button" class="status-badge" data-badge hidden aria-haspopup="dialog" aria-label={tr('action.inLists', { title })}>
    <span class="status-badge__check">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
    </span>
    <span class="status-badge__label" data-badge-label aria-hidden="true"></span>
  </button>
  <dialog class="popover" data-menu aria-label={tr('action.options', { title })}>
    <div class="menu" data-menu-items></div>
  </dialog>
</div>

<style>
  /* Reserva a altura do botão (48px) desde o início: enquanto o estado da lista carrega, Add e badge
     ficam escondidos, e sem isso o título e as informações ao lado pulariam quando o botão aparecesse. */
  .add-status {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
  }

  .add-button,
  .status-badge {
    height: 48px;
    border-radius: 999px;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .add-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    /* 79px no mínimo ("Add"); cresce com o texto traduzido ("Adicionar"). */
    min-width: 79px;
    padding: 0 16px;
    white-space: nowrap;
    line-height: 1;
    border: 0;
    /* Translúcido: funciona sobre backdrops e sobre o fundo da página. */
    background-color: #00000055;
    color: #fff;
    font-size: 1.0625rem;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .add-button:hover {
    background-color: #00000077;
  }

  /* Badge: bolinha verde com o check. */
  .status-badge {
    display: inline-flex;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
  }

  .status-badge__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-added);
  }

  /* O nome da lista só existe nos cards e no topo da página do título (ver abaixo). */
  .status-badge__label {
    display: none;
  }

  .status-badge.is-entering {
    animation: badge-in 260ms ease-out;
  }

  /* Só no desktop (largura de 768px ou mais, com mouse): no celular o badge é só a bolinha verde com o check. */
  @media (hover: hover) and (min-width: 768px) {
    /* Nos cards e no topo da página do título: a bolinha (32px) fica dentro de um círculo escuro translúcido de 48px, igual ao Add.
       Com o mouse sobre ela (ou logo depois de adicionar), vira uma pílula com o nome da lista; o nome
       entra e sai com fade e a largura anima. Sem o mouse, volta a ser só a bolinha. */
    :global(:is(.title-card, .hero)) .status-badge {
      box-sizing: border-box;
      justify-content: flex-start;
      width: 48px;
      height: 48px;
      padding: 8px;
      overflow: hidden;
      border-radius: 999px;
      /* Mesmo fundo do botão Add. */
      background-color: #00000055;
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
      transition:
        width 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
        background-color 220ms ease;
    }

    :global(:is(.title-card, .hero)) .status-badge__check {
      width: 32px;
      height: 32px;
    }

    :global(:is(.title-card, .hero)) .status-badge__check svg {
      width: 20px;
      height: 20px;
    }

    :global(:is(.title-card, .hero)) .status-badge__label {
      display: block;
      padding-inline: 8px 8px;
      font-size: 1rem;
      line-height: 1;
      white-space: nowrap;
      opacity: 0;
      transition: opacity 160ms ease;
    }

    :global(:is(.title-card, .hero)) .status-badge:hover,
    :global(:is(.title-card, .hero)) .status-badge:focus-visible,
    :global(:is(.title-card, .hero)) .status-badge.is-open {
      width: var(--expanded-width, auto);
      background-color: #00000077;
    }

    :global(:is(.title-card, .hero)) .status-badge:hover .status-badge__label,
    :global(:is(.title-card, .hero)) .status-badge:focus-visible .status-badge__label,
    :global(:is(.title-card, .hero)) .status-badge.is-open .status-badge__label {
      opacity: 1;
      /* O nome entra um instante depois de a pílula começar a abrir. */
      transition-delay: 90ms;
    }

    @media (prefers-reduced-motion: reduce) {
      :global(:is(.title-card, .hero)) .status-badge,
      :global(:is(.title-card, .hero)) .status-badge__label {
        transition-duration: 1ms;
      }
    }
  }

  .add-button:disabled,
  .status-badge:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  @keyframes badge-in {
    from {
      transform: scale(0.6);
      opacity: 0;
    }
  }
</style>

<script>
  import { initAddStatus } from '../../lib/lists/add-status';

  // A navegação troca a página sem recarregar o script: inicializa a cada visita.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-add-status]').forEach((root) => {
      void initAddStatus(root);
    });
  });
</script>
