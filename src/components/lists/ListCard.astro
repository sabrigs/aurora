---
// Card de lista da Home: título, contador no canto superior direito e
// prévia em leque com os 3 últimos títulos. A Home preenche os dados no cliente.
interface Props {
  kind: 'to_watch' | 'watching' | 'watched' | 'favorites';
  name: string;
}

const { kind, name } = Astro.props;
---

<a class="list-card" href={`/lists/${kind}`} data-list-kind={kind}>
  <div class="list-card__header">
    <h2>{name}</h2>
    <span class="count" data-count aria-label="Titles in list">0</span>
  </div>
  <div class="fan" aria-hidden="true">
    <span class="poster poster--loading" data-poster></span>
    <span class="poster poster--loading" data-poster></span>
    <span class="poster poster--loading" data-poster></span>
  </div>
</a>

<style>
  .list-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 340px;
    padding: 20px 20px 0;
    box-sizing: border-box;
    border: 2px solid #2b2b2b;
    border-radius: 16px;
    background-color: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    overflow: hidden;
  }

  .list-card:hover {
    background-color: var(--color-surface-raised);
  }

  .list-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .count {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  /* Leque de pôsteres ancorado na borda inferior do card, cortado por ela. */
  .fan {
    position: relative;
    flex: 1;
  }

  .poster {
    position: absolute;
    bottom: -22px;
    left: 50%;
    width: var(--poster-w, 130px);
    aspect-ratio: 2 / 3;
    margin-left: calc(var(--poster-w, 130px) / -2);
    border-radius: 4px 4px 0 0;
    background-color: var(--color-surface-raised);
    background-size: cover;
    background-position: center;
    box-shadow: 0 8px 24px #00000066;
    transform-origin: 50% 100%;
  }

  .poster:nth-child(1) {
    transform: translateX(calc(var(--fan-offset, 90px) * -1)) rotate(-10deg);
    z-index: 1;
  }

  /* Centro maior e mais alto que os das laterais. */
  .poster:nth-child(2) {
    width: var(--poster-center-w, 160px);
    margin-left: calc(var(--poster-center-w, 160px) / -2);
    transform: translateY(-16px);
    z-index: 3;
  }

  .poster:nth-child(3) {
    transform: translateX(var(--fan-offset, 90px)) rotate(10deg);
    z-index: 2;
  }

  /* Skeleton enquanto a lista carrega; vira o pôster, ou a silhueta se a lista estiver vazia. */
  .poster--loading {
    background: linear-gradient(90deg, var(--color-surface-raised) 25%, var(--color-surface-hover) 50%, var(--color-surface-raised) 75%);
    background-size: 200% 100%;
    animation: poster-shimmer 1.2s linear infinite;
  }

  .poster--silhouette {
    background-image: linear-gradient(180deg, var(--color-surface-hover), var(--color-surface-raised));
  }

  @keyframes poster-shimmer {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .poster--loading {
      animation: none;
    }
  }
</style>
