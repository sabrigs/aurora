---
// Card de lista (Home e My lists): miniatura quadrada com os 4 últimos títulos adicionados,
// e à direita o nome da lista com a quantidade de itens (como as playlists do Spotify).
// Lista vazia: os 4 espaços ficam como silhueta. Os dados são preenchidos no cliente.
interface Props {
  kind: 'to_watch' | 'watching' | 'watched' | 'favorites';
  name: string;
}

const { kind, name } = Astro.props;
---

<a class="list-card" href={`/lists/${kind}`} data-list-kind={kind}>
  <div class="thumb" aria-hidden="true">
    <span class="poster poster--loading" data-poster></span>
    <span class="poster poster--loading" data-poster></span>
    <span class="poster poster--loading" data-poster></span>
    <span class="poster poster--loading" data-poster></span>
  </div>
  <div class="info">
    <h2>{name}</h2>
    <span class="count" data-count aria-label="Titles in list">0</span>
  </div>
</a>

<style>
  .list-card {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 8px;
    border-radius: 12px;
    background-color: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    overflow: hidden;
  }

  .list-card:hover {
    background-color: var(--color-surface-raised);
  }

  /* Quadrado 2x2 com os pôsteres, do mais recente (topo à esquerda) ao mais antigo. */
  .thumb {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 2px;
    flex: 0 0 auto;
    width: 140px;
    height: 140px;
    border-radius: 8px;
    overflow: hidden;
  }

  .poster {
    background-color: var(--color-surface-raised);
    background-size: cover;
    background-position: center;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .count {
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-text-muted);
  }

  /* Skeleton enquanto a lista carrega; vira o pôster, ou a silhueta se a lista estiver vazia. */
  .poster--loading {
    background: linear-gradient(90deg, var(--color-surface-raised) 25%, var(--color-surface-hover) 50%, var(--color-surface-raised) 75%);
    background-size: 200% 100%;
    animation: poster-shimmer 1.2s linear infinite;
  }

  .poster--silhouette {
    background-image: linear-gradient(180deg, var(--color-surface-hover), var(--color-surface-raised));
  }

  @keyframes poster-shimmer {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .poster--loading {
      animation: none;
    }
  }
</style>
