---
import { serverT } from '../../lib/i18n';

const tr = serverT(Astro.locals);
// Botão de filtro ao lado da busca (navbar) e o dropdown com as opções. O estado fica em
// lib/ui/explore-filters.ts; o Explore da Home escuta as mudanças e refaz a lista.
---

<button type="button" class="search-filter-button" id="search-filter-button" aria-haspopup="dialog" aria-label={tr('filters.title')}>
	<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M4 7h16M7 12h10M10 17h4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" />
	</svg>
</button>

<dialog class="popover" id="search-filter-menu" aria-label={tr('filters.title')}>
	<div class="menu">
		<button type="button" class="menu-item check-item" role="menuitemcheckbox" aria-checked="false" data-show-listed>
			<span class="check-box" aria-hidden="true"></span>{tr('filters.showListed')}
		</button>

		<p class="menu-section-title">{tr('filters.category')}</p>
		<div class="menu" role="group" aria-label={tr('filters.category')}>
			<button type="button" class="menu-item menu-item--option" role="menuitemradio" data-category="all">{tr('common.all')}</button>
			<button type="button" class="menu-item menu-item--option" role="menuitemradio" data-category="movie">{tr('filters.movies')}</button>
			<button type="button" class="menu-item menu-item--option" role="menuitemradio" data-category="tv">{tr('filters.tv')}</button>
		</div>

		<p class="menu-section-title">{tr('filters.streamings')}</p>
		<div class="menu" role="group" aria-label={tr('filters.streamings')}>
			<button type="button" class="menu-item menu-item--option" role="menuitemradio" data-streamings="all">{tr('common.all')}</button>
			<button type="button" class="menu-item menu-item--option" role="menuitemradio" data-streamings="mine">{tr('filters.justMine')}</button>
		</div>
	</div>
</dialog>

<style>
	.search-filter-button {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 48px;
		width: 48px;
		height: 48px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background-color: var(--color-surface-raised);
		color: var(--color-text);
		box-shadow: 0 2px 5px 0 #0000001f;
		cursor: pointer;
	}

	.search-filter-button:hover {
		background-color: var(--color-surface-hover);
	}

	/* Ponto de destaque quando há algum filtro ativo. */
	.search-filter-button[data-active]::after {
		content: '';
		position: absolute;
		top: 10px;
		right: 10px;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: var(--color-solid);
	}

	.menu-section-title {
		margin: 12px 0 0;
		padding: 8px 0;
		color: var(--color-text);
		font-size: 1.0625rem;
		font-weight: 600;
	}
</style>

<script>
	import { enableLightDismiss, openPopover } from '../../lib/ui/popover';
	import { activeFilterCount, FILTERS_EVENT, getFilters, setFilters } from '../../lib/ui/explore-filters';
	import type { Category, ExploreFilters, StreamingScope } from '../../lib/ui/explore-filters';

	const button = document.getElementById('search-filter-button') as HTMLButtonElement;
	const menu = document.getElementById('search-filter-menu') as HTMLDialogElement;
	const showListed = menu.querySelector<HTMLButtonElement>('[data-show-listed]')!;
	const categoryOptions = [...menu.querySelectorAll<HTMLButtonElement>('[data-category]')];
	const streamingOptions = [...menu.querySelectorAll<HTMLButtonElement>('[data-streamings]')];

	const render = (filters: ExploreFilters) => {
		// O filtro guarda "esconder"; a caixa mostra o inverso (marcada = mostra o que já está nas listas).
		showListed.setAttribute('aria-checked', String(!filters.hideListed));
		for (const option of categoryOptions) {
			const selected = option.dataset.category === filters.category;
			option.setAttribute('aria-checked', String(selected));
			option.classList.toggle('menu-item--selected', selected);
		}
		for (const option of streamingOptions) {
			const selected = option.dataset.streamings === filters.streamings;
			option.setAttribute('aria-checked', String(selected));
			option.classList.toggle('menu-item--selected', selected);
		}
		button.toggleAttribute('data-active', activeFilterCount(filters) > 0);
	};

	button.addEventListener('click', () => openPopover(menu, button));
	enableLightDismiss(menu);

	showListed.addEventListener('click', () => setFilters({ hideListed: !getFilters().hideListed }));
	categoryOptions.forEach((option) =>
		option.addEventListener('click', () => setFilters({ category: option.dataset.category as Category })),
	);
	streamingOptions.forEach((option) =>
		option.addEventListener('click', () => setFilters({ streamings: option.dataset.streamings as StreamingScope })),
	);

	document.addEventListener(FILTERS_EVENT, (event) => render((event as CustomEvent<ExploreFilters>).detail));
	render(getFilters());
</script>
