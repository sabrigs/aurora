---
// Navbar: botão de voltar à esquerda (nas telas internas), filtro + busca centralizados; no desktop, "Home" (listas + Explore), "My lists" e o avatar à direita.
// No mobile, a navegação vai para a toolbar inferior (BottomNav) e o avatar fica no header.
import AvatarMenu from './AvatarMenu.astro';
import SearchFilters from './SearchFilters.astro';
import InputField from '../ui/InputField.astro';
import { serverT } from '../../lib/i18n';

const tr = serverT(Astro.locals);

const path = Astro.url.pathname;
const isCurrent = (href: string, current: string) =>
	href === '/' ? current === '/' : current === href || current.startsWith(`${href}/`);
const current = (href: string) => (isCurrent(href, path) ? 'page' : undefined);
---

<header class="app-header">
	<a class="header-back" href="/" aria-label={tr('nav.back')} hidden>
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M15 18l-6-6 6-6" />
		</svg>
	</a>
	<div class="header-tools">
		<SearchFilters />
		<form class="header-search" role="search" data-header-search>
			<InputField id="header-search-input" type="search" shape="pill" placeholder={tr('search.placeholder')} aria-label={tr('search.aria')} autocomplete="off">
				<svg slot="leading" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" fill="none" />
					<path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				</svg>
				<button slot="trailing" type="button" class="header-search__clear" data-search-clear aria-label={tr('search.clear')}>
					<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
					</svg>
				</button>
			</InputField>
		</form>
	</div>
	<nav class="desktop-nav" aria-label={tr('nav.main')}>
		<a href="/" aria-current={current('/')}>{tr('nav.home')}</a>
		<a href="/lists" aria-current={current('/lists')}>{tr('nav.myLists')}</a>
	</nav>
	<span class="header-title" aria-hidden="true"></span>
	<div class="avatar-slot">
		<AvatarMenu />
	</div>
</header>

<script>
	// A navbar fica persistente entre navegações: atualiza o link da página atual.
	const markCurrentPage = () => {
		const path = window.location.pathname;
		document.querySelectorAll<HTMLAnchorElement>('.app-header a[href]').forEach((link) => {
			const href = link.getAttribute('href') ?? '';
			const isCurrent = href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
			if (isCurrent) {
				link.setAttribute('aria-current', 'page');
			} else {
				link.removeAttribute('aria-current');
			}
		});
	};

	markCurrentPage();
	document.addEventListener('astro:page-load', markCurrentPage);

	// País da pessoa pela geolocalização (pede permissão na primeira vez); decide streamings e cinemas.
	void ensureRegion();
	document.addEventListener('astro:page-load', () => void ensureRegion());

	// Navbar sem fundo só no topo: passando de 40px de rolagem, o fundo volta (para o conteúdo não
	// ficar por baixo dos botões sem contraste).
	const updateHeaderSolid = () => {
		document.documentElement.toggleAttribute('data-header-solid', window.scrollY > 40);
	};
	window.addEventListener('scroll', updateHeaderSolid, { passive: true });
	document.addEventListener('astro:page-load', updateHeaderSolid);
	updateHeaderSolid();

	// Mobile: título da tela no centro da navbar. A tela o declara com [data-header-title] (AppLayout).
	const headerTitle = document.querySelector<HTMLElement>('.header-title')!;
	const updateHeaderTitle = () => {
		const text = document.querySelector<HTMLElement>('[data-header-title]')?.dataset.headerTitle ?? '';
		headerTitle.textContent = text;
		document.documentElement.toggleAttribute('data-has-header-title', Boolean(text));
	};
	updateHeaderTitle();
	document.addEventListener('astro:page-load', updateHeaderTitle);

	// Mobile, só na Home: a navbar some ao rolar para baixo e volta ao rolar para cima (ou no topo da página).
	const root = document.documentElement;
	let lastY = window.scrollY;
	const updateHeaderHidden = () => {
		const y = Math.max(window.scrollY, 0);
		const delta = y - lastY;
		const onHome = (window.location.pathname.replace(/\/$/, '') || '/') === '/';
		if (!onHome || root.hasAttribute('data-search-open') || y < 40) {
			root.removeAttribute('data-header-hidden');
		} else if (Math.abs(delta) > 6) {
			root.toggleAttribute('data-header-hidden', delta > 0);
		}
		lastY = y;
	};
	window.addEventListener('scroll', updateHeaderHidden, { passive: true });
	document.addEventListener('astro:page-load', () => {
		lastY = window.scrollY;
		root.removeAttribute('data-header-hidden');
	});

	// Botão de voltar: aparece em toda tela interna (fora da Home e de My lists). Volta no histórico
	// quando há uma tela anterior do app (igual ao voltar do navegador); se foi aberta direto, vai para a tela "mãe".
	const backLink = document.querySelector<HTMLAnchorElement>('.header-back')!;
	const updateBack = () => {
		const path = window.location.pathname.replace(/\/$/, '') || '/';
		backLink.hidden = path === '/' || path === '/lists';
		backLink.href = path.startsWith('/lists/') ? '/lists' : '/';
	};
	updateBack();
	document.addEventListener('astro:page-load', updateBack);
	bindBackLink(backLink);

	// Busca da navbar: campo na própria navbar (desktop) ou barra sob ela, aberta pela tab Search (mobile).
	// Na Home, avisa o Explore a cada digitação; nas outras telas, Enter leva à Home com a busca feita.
	import { announceSearch, clearSearch, setSearchOpen, setSearchQuery, syncSearchMode } from '../../lib/ui/search';
	import { ensureRegion } from '../../lib/region/locate';
	import { bindBackLink } from '../../lib/ui/navigation';

	const searchForm = document.querySelector<HTMLFormElement>('[data-header-search]')!;
	const searchInput = document.getElementById('header-search-input') as HTMLInputElement;
	const isHome = () => window.location.pathname === '/';

	searchInput.addEventListener('input', () => {
		syncSearchMode();
		if (isHome()) announceSearch(searchInput.value);
	});

	searchForm.addEventListener('submit', (event) => {
		event.preventDefault();
		const query = searchInput.value.trim();
		if (!query) return;
		if (isHome()) {
			announceSearch(query, true);
			searchInput.blur(); // fecha o teclado no mobile
		} else {
			window.location.href = `/?q=${encodeURIComponent(query)}`;
		}
	});

	searchForm.querySelector('[data-search-clear]')!.addEventListener('click', clearSearch);

	document.addEventListener('astro:page-load', () => {
		if (!isHome()) {
			// Fora da Home a busca não vale: zera o campo e o modo busca.
			setSearchQuery('');
			setSearchOpen(false);
		} else if (new URLSearchParams(window.location.search).get('search') === '1') {
			setSearchOpen(true);
		}
	});
</script>

<style>
	.app-header {
		display: flex;
		align-items: center;
		gap: 24px;
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 20;
		box-sizing: border-box;
		height: var(--header-height);
		/* 16px em cima e embaixo: os itens de 48px ocupam a altura toda (80px). */
		padding: 16px;
		background-color: var(--color-bg);
		transition: background-color 200ms ease;
	}

	/* Telas com clearHeader (ex.: título): sem fundo no topo; com a rolagem, o fundo volta. */
	:global(html[data-header-clear]:not([data-header-solid])) .app-header {
		background-color: transparent;
	}

	/* Botão de voltar: círculo discreto só com o ícone, no canto esquerdo. */
	.header-back {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 48px;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		/* Mesmo fundo discreto do botão de filtro da busca. */
		background-color: var(--color-surface-raised);
		color: var(--color-text);
		box-shadow: 0 2px 5px 0 #0000001f;
	}

	.header-back:hover {
		background-color: var(--color-surface-hover);
	}

	.header-back[hidden] {
		display: none;
	}

	/* Filtro + busca, centralizados na navbar independente do menu à direita. */
	.header-tools {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.header-search {
		width: 380px;
		max-width: 36vw;
	}

	.header-search__clear {
		display: none;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 28px;
		height: 28px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: none;
		color: var(--color-text-muted);
		cursor: pointer;
	}

	/* X aparece quando há texto. */
	.header-search:has(:global(input:not(:placeholder-shown))) .header-search__clear {
		display: inline-flex;
	}

	.desktop-nav {
		display: flex;
		gap: 8px;
		margin-left: auto;
	}

	.desktop-nav a {
		padding: 8px 12px;
		border-radius: 8px;
		font-size: 1.0625rem;
		font-weight: 500;
		color: var(--color-text);
		text-decoration: none;
	}

	.desktop-nav a[aria-current='page'] {
		text-decoration: underline;
		text-underline-offset: 6px;
	}

	.desktop-nav a:hover {
		background-color: var(--color-surface-hover);
	}

	.avatar-slot {
		margin-left: 8px;
	}

	/* Só no mobile (título da tela no centro da navbar). */
	.header-title {
		display: none;
	}

	/* Tablet: não há espaço para centralizar a busca sem cobrir "Home" e "My lists": ela vai para a esquerda,
	   depois do botão de voltar (quando há). */
	@media (min-width: 768px) and (max-width: 1023px) {
		.header-tools {
			position: static;
			transform: none;
		}
	}

	@media (max-width: 767px) {
		.desktop-nav {
			display: none;
		}

		/* Mobile: filtro + busca são uma barra sob o header, aberta pela tab Search. */
		.header-tools {
			display: none;
			position: fixed;
			top: 16px;
			left: 16px;
			right: 16px;
			transform: none;
		}

		.header-search {
			flex: 1 1 auto;
			width: auto;
			max-width: none;
		}

		:global(html[data-search-open]) .header-tools {
			display: flex;
		}

		/* Com a busca aberta, a navbar fica só com o filtro e o campo de busca. */
		:global(html[data-search-open]) .header-back,
		:global(html[data-search-open]) .header-title,
		:global(html[data-search-open]) .avatar-slot {
			display: none;
		}

		:global(html[data-search-open]) .header-search__clear {
			display: inline-flex;
		}

		.avatar-slot {
			margin-left: auto;
		}

		.app-header {
			transition:
				background-color 200ms ease,
				transform 250ms ease;
		}

		:global(html[data-header-hidden]) .app-header {
			transform: translateY(-100%);
		}

		.header-title {
			display: block;
			position: absolute;
			left: 50%;
			top: 50%;
			transform: translate(-50%, -50%);
			/* Respeita os botões de 48px das pontas (16px de margem + 48px + 12px de respiro). */
			max-width: calc(100% - 152px);
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			font-size: 1.25rem;
			font-weight: 600;
			color: var(--color-text);
			pointer-events: none;
		}
	}
</style>
