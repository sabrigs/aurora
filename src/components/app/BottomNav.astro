---
// Tab bar fixa na base da tela, no mobile, com "Home", "Search" e "My lists".
// É uma única instância persistente (ver AppLayout): o estado ativo e a visibilidade vêm da URL, via script.
---


<nav class="bottom-nav" aria-label="Main" hidden>
	<a href="/" data-nav="/">
		<svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
			<path d="M4 11l8-7 8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linejoin="round" />
		</svg>
		<span>Home</span>
	</a>
	<button type="button" data-search-tab aria-label="Search">
		<svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" fill="none" />
			<path d="M20 20l-4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
		</svg>
		<span>Search</span>
	</button>
	<a href="/lists" data-nav="/lists">
		<svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
			<rect x="3" y="7" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.8" fill="none" />
			<path d="M9 3l3 4 3-4" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" />
		</svg>
		<span>My lists</span>
	</a>
</nav>

<style>
	.bottom-nav {
		display: none;
	}

	.bottom-nav[hidden] {
		display: none !important;
	}

	@media (max-width: 767px) {
		/* Barra colada na base, ocupando toda a largura, com fundo translúcido. */
		.bottom-nav {
			position: fixed;
			left: 0;
			right: 0;
			bottom: 0;
			display: flex;
			justify-content: center;
			gap: 8px;
			padding: 8px 16px calc(8px + env(safe-area-inset-bottom));
			border-top: 1px solid #2b2b2b;
			background-color: #1c1c1eeb;
			-webkit-backdrop-filter: blur(20px);
			backdrop-filter: blur(20px);
			z-index: 10;
		}

		.bottom-nav a,
		.bottom-nav button {
			display: flex;
			flex: 1 1 0;
			flex-direction: column;
			align-items: center;
			gap: 4px;
			max-width: 160px;
			padding: 10px 12px;
			border: 1px solid transparent;
			border-radius: 999px;
			background: none;
			color: var(--color-text-muted);
			font: inherit;
			font-size: 0.8125rem;
			font-weight: 500;
			text-decoration: none;
			cursor: pointer;
		}

		/* Item selecionado: efeito glass. */
		.bottom-nav a[aria-current='page'],
		:global(html[data-search-open]) .bottom-nav button[data-search-tab] {
			color: var(--color-text);
			background-color: #ffffff1f;
			border-color: #ffffff1f;
			box-shadow: inset 0 1px 0 #ffffff26;
			-webkit-backdrop-filter: blur(12px);
			backdrop-filter: blur(12px);
		}

		/* Com a busca aberta, o item ativo é o Search, não o Home. */
		:global(html[data-search-open]) .bottom-nav a[aria-current='page'] {
			color: var(--color-text-muted);
			background: none;
			border-color: transparent;
			box-shadow: none;
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
	}
</style>

<script>
	import { navigate } from 'astro:transitions/client';
	import { clearSearch, setSearchOpen } from '../../lib/ui/search';

	const nav = document.querySelector<HTMLElement>('.bottom-nav')!;
	const searchTab = nav.querySelector<HTMLButtonElement>('[data-search-tab]')!;

	// A tab bar é a mesma em todas as telas de primeiro nível (Home e My lists) e some nas demais.
	const sync = () => {
		const path = window.location.pathname.replace(/\/$/, '') || '/';
		nav.hidden = path !== '/' && path !== '/lists';
		nav.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach((link) => {
			if (link.dataset.nav === path) link.setAttribute('aria-current', 'page');
			else link.removeAttribute('aria-current');
		});
	};

	// Search: abre a barra de busca e o teclado. Fora da Home, vai para a Home com a busca aberta.
	searchTab.addEventListener('click', () => {
		if (window.location.pathname !== '/') {
			void navigate('/?search=1');
			return;
		}
		if (document.documentElement.hasAttribute('data-search-open')) clearSearch();
		else setSearchOpen(true); // o foco acontece dentro do toque, para o teclado abrir no iOS
	});

	// Tocar em Home/My lists com a busca aberta fecha a busca.
	nav.querySelectorAll('[data-nav]').forEach((link) => link.addEventListener('click', clearSearch));

	sync();
	document.addEventListener('astro:page-load', sync);
</script>
