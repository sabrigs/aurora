---
import { safeJson } from '../../lib/safe-json';
import { getRegionProviders } from '../../lib/streaming/availability';
import { logoUrl } from '../../lib/tmdb/images';
import { LANGS, serverT, toLang } from '../../lib/i18n';

const tr = serverT(Astro.locals);
const lang = toLang(Astro.locals.lang);

// Os mesmos streamings do onboarding (os do país da pessoa), para adicionar pelo menu.
const providers = await getRegionProviders('movie').catch(() => []);
const providersForClient = providers.map((provider) => ({
	id: provider.id,
	name: provider.name,
	logoPath: provider.logoPath,
	logoUrl: logoUrl(provider.logoPath),
}));
---

<button type="button" class="avatar" id="avatar-button" aria-haspopup="dialog" aria-label={tr('account.openMenu')}>
	<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8" fill="none"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
</button>

<dialog class="popover" id="avatar-menu" aria-label={tr('account.title')}>
	<div id="avatar-main" class="menu">
		<div class="menu-header">
			<strong id="avatar-name"></strong>
			<span id="avatar-member-since"></span>
		</div>
		<button type="button" class="menu-item" id="open-streamings">
			<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.8" fill="none"/><path d="M9 3l3 4 3-4" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg><span>{tr('account.myStreamings')}</span><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" class="chevron"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
		</button>
		<button type="button" class="menu-item" id="export-data">
			<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4M4 20h16" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{tr('account.export')}</span>
		</button>
		<a class="menu-item" id="open-changelog" href="/changelog">
			<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/></svg><span>{tr('account.changelog')}</span>
		</a>
		<button type="button" class="menu-item" id="open-language">
			<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h9M8.5 3v2M6 5c0 4 2.5 7 6 8.5M12 5c0 3.5-2.5 6.5-6.5 8.5M12.5 21l4.5-10 4.5 10M14 17.5h6" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{tr('account.language')}</span><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" class="chevron"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
		</button>
		<button type="button" class="menu-item" id="sign-out">
			<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h4a2 2 0 012 2v12a2 2 0 01-2 2h-4M10 8l-4 4 4 4M6 12h10" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{tr('account.signOut')}</span>
		</button>
	</div>

	<div id="avatar-streamings" class="menu" hidden>
		<div class="streamings-header">
			<button type="button" class="icon-button" id="back-to-menu" aria-label={tr('nav.back')}><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
			<strong>{tr('account.myStreamings')}</strong>
		</div>
		<div id="streaming-checklist" class="menu" role="group" aria-label={tr('account.myStreamings')}></div>
	</div>

	<div id="avatar-language" class="menu" hidden>
		<div class="streamings-header">
			<button type="button" class="icon-button" id="back-from-language" aria-label={tr('nav.back')}><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
			<strong>{tr('account.language')}</strong>
		</div>
		<div class="menu" role="group" aria-label={tr('account.language')}>
			{LANGS.map((code) => (
				<button type="button" class:list={['menu-item', 'menu-item--option', { 'menu-item--selected': code === lang }]} role="menuitemradio" aria-checked={String(code === lang)} data-lang={code}>{tr(`lang.${code}`)}</button>
			))}
		</div>
	</div>
</dialog>

<script id="avatar-providers" type="application/json" set:html={safeJson(providersForClient)} />

<style>
	/* Mesmo tamanho e visual do botão de voltar e do botão de filtro da navbar. */
	.avatar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 48px;
		width: 48px;
		height: 48px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background-color: var(--color-surface-raised);
		color: var(--color-text);
		box-shadow: 0 2px 5px 0 #0000001f;
		cursor: pointer;
	}

	.avatar:hover {
		background-color: var(--color-surface-hover);
	}

	.streamings-header {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 4px 4px 12px;
		font-size: 1.25rem;
		font-weight: 600;
	}

	.icon-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 999px;
		border: 0;
		background-color: var(--color-surface-hover);
		color: var(--color-text);
		cursor: pointer;
	}
</style>

<script>
	import { supabase } from '../../lib/supabase.js';
	import {
		addStreaming,
		getUserStreamings,
		removeStreaming,
		type StreamingRow,
	} from '../../lib/lists/store';
	import { enableLightDismiss, openPopover } from '../../lib/ui/popover';
	import { downloadExport } from '../../lib/lists/export';
	import { brandName } from '../../lib/streaming/canonical';
	import { clearAuthMemory } from '../../lib/auth/gate';
	import { currentLang, localeOf, setLang, t, toLang } from '../../lib/i18n';

	type Provider = { id: number; name: string; logoPath: string | null; logoUrl: string | null };

	const avatarButton = document.getElementById('avatar-button') as HTMLButtonElement;
	const menu = document.getElementById('avatar-menu') as HTMLDialogElement;
	const mainPanel = document.getElementById('avatar-main') as HTMLDivElement;
	const streamingsPanel = document.getElementById('avatar-streamings') as HTMLDivElement;
	const languagePanel = document.getElementById('avatar-language') as HTMLDivElement;
	const nameEl = document.getElementById('avatar-name') as HTMLElement;
	const memberSince = document.getElementById('avatar-member-since') as HTMLSpanElement;
	const checklist = document.getElementById('streaming-checklist') as HTMLDivElement;
	const providers: Provider[] = JSON.parse(
		document.getElementById('avatar-providers')?.textContent ?? '[]',
	);

	type ChecklistRow = { brand: string; owned: boolean; provider: Provider | null; stored: StreamingRow | null };

	// Lista única: os streamings marcados ficam em cima, os desmarcados embaixo.
	// A ordem é definida ao abrir a lista; clicar só muda a marcação, sem reordenar.
	const renderStreamings = (owned: StreamingRow[]) => {
		const storedByBrand = new Map(owned.map((row) => [brandName(row.providerName), row]));
		const rows: ChecklistRow[] = providers.map((provider) => ({
			brand: provider.name,
			owned: storedByBrand.has(provider.name),
			provider,
			stored: storedByBrand.get(provider.name) ?? null,
		}));

		// Streamings salvos que não estão entre os 5 principais continuam visíveis e marcados.
		for (const [brand, stored] of storedByBrand) {
			if (!providers.some((provider) => provider.name === brand)) {
				rows.push({ brand, owned: true, provider: null, stored });
			}
		}

		rows.sort((a, b) => Number(b.owned) - Number(a.owned));
		checklist.replaceChildren(...rows.map((row) => checkItem(row)));
	};

	const checkItem = (row: ChecklistRow) => {
		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'menu-item check-item';
		button.setAttribute('role', 'menuitemcheckbox');
		button.setAttribute('aria-checked', String(row.owned));

		const box = document.createElement('span');
		box.className = 'check-box';
		box.setAttribute('aria-hidden', 'true');
		button.append(box, row.brand);

		button.addEventListener('click', async () => {
			// Atualiza na hora; se o Supabase falhar, volta ao estado anterior.
			const wasChecked = row.owned;
			row.owned = !wasChecked;
			button.setAttribute('aria-checked', String(row.owned));

			try {
				if (row.owned && row.provider) {
					await addStreaming(row.provider);
					row.stored = { providerId: row.provider.id, providerName: row.provider.name, logoPath: row.provider.logoPath };
				} else if (row.stored) {
					await removeStreaming(row.stored.providerId);
					row.stored = null;
				}
			} catch (error) {
				console.error(error);
				row.owned = wasChecked;
				button.setAttribute('aria-checked', String(wasChecked));
			}
		});

		return button;
	};

	const showPanel = (panel: 'main' | 'streamings' | 'language') => {
		mainPanel.hidden = panel !== 'main';
		streamingsPanel.hidden = panel !== 'streamings';
		languagePanel.hidden = panel !== 'language';
	};

	// "29th oct 2026" em inglês; "29 out 2026" em português.
	const formatMemberSince = (iso: string) => {
		const lang = currentLang();
		const date = new Date(iso);
		const day = date.getDate();
		const month = date.toLocaleDateString(localeOf(lang), { month: 'short' }).replace('.', '').toLowerCase();
		const ordinal = (n: number) => {
			if (n % 100 >= 11 && n % 100 <= 13) return `${n}th`;
			return `${n}${['th', 'st', 'nd', 'rd'][n % 10 > 3 ? 0 : n % 10]}`;
		};
		return `${lang === 'pt-BR' ? day : ordinal(day)} ${month} ${date.getFullYear()}`;
	};

	const loadProfile = async () => {
		const { data: sessionData } = await supabase.auth.getSession();
		const session = sessionData.session;
		if (!session) return;

		const { data: profile } = await supabase
			.from('profiles')
			.select('display_name, created_at')
			.eq('user_id', session.user.id)
			.single();

		const name = profile?.display_name || session.user.email || t('account.fallbackName');
		nameEl.textContent = name;
		if (profile?.created_at) {
			memberSince.textContent = t('account.memberSince', { date: formatMemberSince(profile.created_at) });
		}
	};

	avatarButton.addEventListener('click', () => {
		showPanel('main');
		openPopover(menu, avatarButton);
	});

	enableLightDismiss(menu);

	document.getElementById('open-streamings')?.addEventListener('click', async () => {
		showPanel('streamings');
		renderStreamings(await getUserStreamings());
	});

	document.getElementById('back-to-menu')?.addEventListener('click', () => showPanel('main'));

	// Idioma: escolher outro grava o cookie e recarrega a página no idioma novo.
	document.getElementById('open-language')?.addEventListener('click', () => showPanel('language'));
	document.getElementById('back-from-language')?.addEventListener('click', () => showPanel('main'));
	languagePanel.querySelectorAll<HTMLButtonElement>('[data-lang]').forEach((option) => {
		option.addEventListener('click', () => {
			const next = toLang(option.dataset.lang);
			if (next === currentLang()) {
				menu.close();
				return;
			}
			setLang(next);
		});
	});

	document.getElementById('export-data')?.addEventListener('click', async (event) => {
		const button = event.currentTarget as HTMLButtonElement;
		button.disabled = true;
		try {
			await downloadExport();
			menu.close();
		} catch (error) {
			console.error(error);
			window.alert(t('account.exportError'));
		} finally {
			button.disabled = false;
		}
	});

	// O menu persiste entre navegações: fecha antes de abrir o Changelog.
	document.getElementById('open-changelog')?.addEventListener('click', () => menu.close());

	document.getElementById('sign-out')?.addEventListener('click', async () => {
		await supabase.auth.signOut();
		clearAuthMemory();
		window.location.replace('/login');
	});

	loadProfile().catch((error) => console.error(error));
</script>
