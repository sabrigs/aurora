---
import AppLayout from '../../layouts/AppLayout.astro';
import { serverT } from '../../lib/i18n';

const LIST_KINDS = ['to_watch', 'watching', 'watched', 'favorites'];
const tr = serverT(Astro.locals);

const kind = Astro.params.kind ?? '';
if (!LIST_KINDS.includes(kind)) {
	return Astro.redirect('/');
}
const name = tr(`list.${kind}`);
---

<AppLayout fullWidth requireAuth flushTop headerTitle={name}>
	<section class="list" data-kind={kind}>
		<h1 class="section-title">{name}</h1>

		<!-- Filtros em chips: streamings do usuário e situação da série. Vários podem ficar marcados. -->
		<div id="chips" class="chips" role="group" aria-label={tr('filters.title')} hidden></div>

		<div id="empty-list" class="empty" hidden>
			<p id="empty-list-text">{tr('list.empty')}</p>
			<a id="empty-list-cta" class="cta" href="/">{tr('list.goExplore')}</a>
		</div>

		<div id="empty-filter" class="empty" hidden>
			<p>{tr('list.noMatch')}</p>
			<button type="button" class="clear" id="clear-filters">{tr('list.clearFilters')}</button>
		</div>

		<div id="grid" class="grid" role="list"></div>

		<!-- Mesmo card da página Explore, sem o botão de adicionar (o título já está na lista). -->
		<template id="card-template">
			<article class="title-card" role="listitem">
				<div class="title-card__media" aria-hidden="true"><img class="title-card__backdrop" alt="" decoding="async" /><div class="title-card__blur"><img alt="" decoding="async" /></div></div>
				<a class="title-card__cover" href="/"></a>
				<div class="title-card__info">
					<img class="title-card__poster" alt="" loading="lazy" decoding="async" hidden />
					<div class="title-card__text">
						<span class="title-card__status" hidden></span>
						<h2 class="title-card__title"></h2>
						<p class="title-card__meta"></p>
						<p class="title-card__progress" hidden></p>
					</div>
				</div>
				<div class="title-card__providers" hidden></div>
			</article>
		</template>
	</section>

	<script>
		import { supabase } from '../../lib/supabase.js';
		import { apiFetch } from '../../lib/api';
		import { episodeKey, getWatchedEpisodes } from '../../lib/lists/progress';
		import { fetchAiredEpisodes } from '../../lib/lists/series-flows';
		import { getListItems, getUserStreamings, type ListItem, type StreamingRow, type SystemKind } from '../../lib/lists/store';
		import { posterUrl } from '../../lib/tmdb/images';
		import { backdropUrl, setCardBackdrop } from '../../lib/tmdb/card-image';
		import { readCardSummary, writeCardSummary, type CardSummary } from '../../lib/tmdb/card-cache';
		import { seriesStatusTag, setCardMeta, setCardProviders, setCardStatus, type SeriesStatusTag } from '../../lib/tmdb/format';
		import { enableDragScroll } from '../../lib/ui/drag-scroll';
		import { t } from '../../lib/i18n';
		import { isReturningVisit, loadScreenState, saveScreenState } from '../../lib/ui/navigation';
		import { brandName } from '../../lib/streaming/canonical';
		import { releaseGate } from '../../lib/auth/gate';

		// A navegação troca a página sem recarregar o script, então a tela é montada a cada visita.
		const setupList = () => {
		const section = document.querySelector<HTMLElement>('.list')!;
		const kind = section.dataset.kind as SystemKind;
		const grid = document.getElementById('grid') as HTMLDivElement;
		const emptyList = document.getElementById('empty-list') as HTMLDivElement;
		const emptyListText = document.getElementById('empty-list-text') as HTMLParagraphElement;
		const emptyListCta = document.getElementById('empty-list-cta') as HTMLAnchorElement;
		const emptyFilter = document.getElementById('empty-filter') as HTMLDivElement;
		const chips = document.getElementById('chips') as HTMLDivElement;
		enableDragScroll(chips);

		type StatusTone = Exclude<SeriesStatusTag['tone'], 'canceled'>;

		const STATUS_FILTERS: { tone: StatusTone; label: string }[] = [
			{ tone: 'ongoing', label: t('status.ongoing') },
			{ tone: 'ended', label: t('status.ended') },
		];

		// Chips marcados: dentro de cada grupo vale "qualquer um"; entre os grupos, "todos".
		// Nada marcado em um grupo = sem filtro por ele.
		const state: { streamingBrands: string[]; statuses: StatusTone[] } = {
			streamingBrands: [],
			statuses: [],
		};
		const STATE_KEY = `aurora:list:v2:${kind}`;
		let items: ListItem[] = [];
		let streamings: StreamingRow[] = [];

		// Disponibilidade de cada título em streamings (cache por sessão de página).
		const availability = new Map<string, Promise<Set<number>>>();
		const keyOf = (item: ListItem) => `${item.mediaType}:${item.tmdbId}`;

		const brandsFor = (item: ListItem) => {
			const key = keyOf(item);
			if (!availability.has(key)) {
				availability.set(
					key,
					apiFetch(`/api/titles/${item.mediaType}/${item.tmdbId}/providers`)
						.then((response) => response.json() as Promise<{ brands: string[] }>)
						.then((data) => new Set(data.brands))
						.catch(() => new Set<number>()),
				);
			}
			return availability.get(key)!;
		};

		const applyFilters = async (): Promise<ListItem[]> => {
			let result = items;

			if (state.streamingBrands.length > 0) {
				const selected = state.streamingBrands;
				const matches = await Promise.all(result.map((item) => brandsFor(item)));
				result = result.filter((_, index) => selected.some((brand) => matches[index].has(brand)));
			}

			// Situação da série (Ongoing, Ended): filmes e títulos sem situação ficam de fora.
			if (state.statuses.length > 0) {
				const selected = state.statuses;
				const details = await Promise.all(result.map((item) => loadSummary(item)));
				result = result.filter((item, index) => {
					const tone = seriesStatusTag(item.mediaType, details[index]?.status)?.tone;
					return tone !== undefined && (selected as string[]).includes(tone);
				});
			}

			return result;
		};

		const cardTemplate = document.getElementById('card-template') as HTMLTemplateElement;

		// Backdrop e nota de cada título, buscados uma vez e reaproveitados.
		// Usa o cache local (localStorage) antes de ir à API: o card já nasce completo, sem trocar de imagem.
		const summaries = new Map<string, Promise<CardSummary | null>>();
		const loadSummary = (item: ListItem) => {
			const key = `${item.mediaType}:${item.tmdbId}`;
			if (!summaries.has(key)) {
				const cached = readCardSummary(item.mediaType, item.tmdbId);
				summaries.set(
					key,
					cached
						? Promise.resolve(cached)
						: apiFetch(`/api/titles/${item.mediaType}/${item.tmdbId}`)
								.then((response) => (response.ok ? (response.json() as Promise<CardSummary>) : null))
								.then((summary) => {
									if (summary) writeCardSummary(item.mediaType, item.tmdbId, summary);
									return summary;
								})
								.catch(() => null),
				);
			}
			return summaries.get(key)!;
		};

		// Em "Watching", cada série mostra quantos episódios já viu e qual é o próximo.
		const seriesProgress = async (item: ListItem) => {
			const [aired, watched] = await Promise.all([fetchAiredEpisodes(item.tmdbId), getWatchedEpisodes(item.tmdbId)]);
			const total = aired.episodes.length;
			if (total === 0) return null;
			const count = aired.episodes.filter((episode) => watched.has(episodeKey(episode))).length;
			const next = aired.episodes.find((episode) => !watched.has(episodeKey(episode)));
			const upNext = next ? t('list.next', { s: next.seasonNumber, e: next.episodeNumber }) : t('list.upToDate');
			return t('list.progress', { done: count, total, next: upNext });
		};

		const renderCard = (item: ListItem, index: number) => {
			const node = cardTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
			const cover = node.querySelector<HTMLAnchorElement>('.title-card__cover')!;
			cover.href = `/title/${item.mediaType}/${item.tmdbId}`;
			cover.setAttribute('aria-label', item.title);
			// Título e pôster no idioma da interface: do cache local se já vieram da TMDB; senão, os que ficaram
			// salvos na lista, trocados assim que o resumo do título chega.
			const cachedSummary = readCardSummary(item.mediaType, item.tmdbId);
			const posterImg = node.querySelector<HTMLImageElement>('.title-card__poster')!;
			const titleEl = node.querySelector<HTMLElement>('.title-card__title')!;
			const showTitle = (title: string | undefined, posterPath: string | null | undefined) => {
				const name = title || item.title;
				titleEl.textContent = name;
				cover.setAttribute('aria-label', name);
				const src = posterUrl(posterPath ?? item.posterPath, 'w185');
				if (src) {
					if (posterImg.getAttribute('src') !== src) posterImg.src = src;
					posterImg.hidden = false;
				}
			};
			showTitle(cachedSummary?.title, cachedSummary?.posterPath);

			const meta = node.querySelector<HTMLElement>('.title-card__meta')!;
			setCardMeta(meta, { mediaType: item.mediaType });

			if (kind === 'watching' && item.mediaType === 'tv') {
				const progress = node.querySelector<HTMLElement>('.title-card__progress')!;
				seriesProgress(item)
					.then((text) => {
						if (!text) return;
						progress.textContent = text;
						progress.hidden = false;
					})
					.catch((error) => console.error(error));
			}

			// O fundo só entra quando o backdrop é conhecido (sem trocar de pôster para backdrop no meio).
			// Os primeiros cards carregam já; os demais, quando chegam perto da tela.
			const eager = index < 6;
			void loadSummary(item).then((summary) => {
				setCardBackdrop(node, backdropUrl(summary?.backdropPath ?? null, item.posterPath), eager);
				if (!summary) return;
				showTitle(summary.title, summary.posterPath);
				setCardMeta(meta, { mediaType: item.mediaType, ...summary });
				setCardStatus(node.querySelector<HTMLElement>('.title-card__status')!, item.mediaType, summary.status);
				setCardProviders(node.querySelector<HTMLElement>('.title-card__providers')!, summary.providers);
			});

			return node;
		};

		const renderGrid = async () => {
			saveScreenState(STATE_KEY, state);
			const visible = await applyFilters();
			grid.replaceChildren(...visible.map((item, index) => renderCard(item, index)));

			emptyList.hidden = items.length > 0;
			emptyFilter.hidden = items.length === 0 || visible.length > 0;
			grid.hidden = items.length > 0 && visible.length === 0;
		};

		// Chips: streamings do usuário, um divisor e a situação da série.
		const renderChips = () => {
			const chip = (label: string, selected: boolean, onClick: () => void) => {
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'chip';
				button.setAttribute('aria-pressed', String(selected));
				button.textContent = label;
				button.addEventListener('click', onClick);
				return button;
			};

			const brands = [...new Set(streamings.map((row) => brandName(row.providerName)))];
			const streamingChips = brands.map((brand) =>
				chip(brand, state.streamingBrands.includes(brand), () => {
					state.streamingBrands = toggle(state.streamingBrands, brand);
					void update();
				}),
			);
			const statusChips = STATUS_FILTERS.map(({ tone, label }) =>
				chip(label, state.statuses.includes(tone), () => {
					state.statuses = toggle(state.statuses, tone);
					void update();
				}),
			);

			const divider = document.createElement('span');
			divider.className = 'chips-divider';
			divider.setAttribute('aria-hidden', 'true');

			chips.replaceChildren(...streamingChips, ...(streamingChips.length > 0 ? [divider] : []), ...statusChips);
			chips.hidden = false;
		};

		const toggle = <T,>(list: T[], value: T): T[] =>
			list.includes(value) ? list.filter((entry) => entry !== value) : [...list, value];

		const update = async () => {
			renderChips();
			await renderGrid();
		};

		document.getElementById('clear-filters')?.addEventListener('click', () => {
			state.streamingBrands = [];
			state.statuses = [];
			void update();
		});

		const load = async () => {
			const { data: sessionData } = await supabase.auth.getSession();
			if (!sessionData.session) {
				window.location.replace('/login');
				return;
			}
			releaseGate();

			try {
				// Ao voltar de um título, mantém os chips escolhidos.
				const saved = isReturningVisit() ? loadScreenState<typeof state>(STATE_KEY) : null;
				if (saved && Array.isArray(saved.streamingBrands) && Array.isArray(saved.statuses)) {
					Object.assign(state, saved);
				}

				[items, streamings] = await Promise.all([getListItems(kind), getUserStreamings()]);
				renderChips();
				await renderGrid();
			} catch (error) {
				console.error(error);
				emptyList.hidden = false;
				emptyListText.textContent = t('list.loadError');
				emptyListCta.hidden = true;
			}
		};

		load();
		};

		document.addEventListener('astro:page-load', () => {
			if (document.querySelector('.list')) setupList();
		});
	</script>
</AppLayout>

<style is:global>
	.list {
		display: flex;
		flex-direction: column;
		gap: 16px;
		/* Mesmo respiro do topo das outras telas com título. */
		padding-top: 16px;
	}

	/* Chips de filtro: streamings do usuário | situação. Rolam na horizontal quando não cabem (mobile). */
	.chips {
		/* Fixos sob a navbar ao rolar a lista, com fundo para os cards passarem por baixo. */
		position: sticky;
		top: var(--header-height);
		z-index: 10;
		display: flex;
		align-items: center;
		gap: 8px;
		margin-inline: -16px;
		padding: 8px 16px;
		background-color: var(--color-bg);
		overflow-x: auto;
		scrollbar-width: none;
	}

	.chips::-webkit-scrollbar {
		display: none;
	}

	.chips.is-dragging {
		cursor: grabbing;
		user-select: none;
	}

	.chip {
		flex: 0 0 auto;
		height: 40px;
		padding: 0 16px;
		border: 0;
		border-radius: 999px;
		background-color: var(--color-surface-raised);
		color: var(--color-text);
		font: inherit;
		font-size: 1rem;
		white-space: nowrap;
		cursor: pointer;
		transition: background-color 150ms ease;
	}

	.chip:hover {
		background-color: var(--color-surface-hover);
	}

	/* Marcado: cor de destaque (indigo). */
	.chip[aria-pressed='true'] {
		background-color: var(--color-selected);
		color: var(--color-on-solid);
	}

	.chip[aria-pressed='true']:hover {
		background-color: var(--color-solid-hover);
	}

	.chips-divider {
		flex: 0 0 1px;
		width: 1px;
		height: 32px;
		margin-inline: 4px;
		background-color: var(--color-border-strong);
	}

	/* Nas listas os cards são mais baixos que no Explore: o título já está na lista, o foco é folhear.
	   220px em telas largas; quando o card fica estreito, o texto quebra mais e precisa de mais altura. */
	.list .title-card {
		height: 300px;
	}

	@media (min-width: 1280px) {
		.list .title-card {
			height: 240px;
		}
	}

	@media (min-width: 1400px) {
		.list .title-card {
			height: 220px;
		}
	}

	.empty {
		margin: 32px 0;
		text-align: center;
		color: var(--color-text-muted);
	}

	.cta {
		display: inline-block;
		margin-top: 12px;
		padding: 10px 18px;
		border-radius: 999px;
		background-color: var(--color-solid);
		color: var(--color-on-solid);
		font-weight: 600;
		text-decoration: none;
	}

	.clear {
		margin-top: 8px;
		padding: 8px 14px;
		border-radius: 999px;
		border: 1px solid var(--color-border-strong);
		background-color: var(--color-surface-raised);
		color: var(--color-text);
		cursor: pointer;
	}

	/* Cards: 3 colunas no desktop, 2 no tablet e 1 no mobile, com 16px de gap. */
	/* 3 colunas ocupando a largura total (largura adaptável, altura fixa, ver title-card.css); 2 no tablet e 1 no mobile. */
	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
		width: 100%;
	}

	@media (max-width: 1023px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 767px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

</style>
