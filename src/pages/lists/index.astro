---
import AppLayout from '../../layouts/AppLayout.astro';
import ListCard from '../../components/lists/ListCard.astro';
import { serverT } from '../../lib/i18n';

const tr = serverT(Astro.locals);
---

<AppLayout fullWidth requireAuth flushTop>
	<section class="all-lists">
		<h1 class="section-title">{tr('home.myLists')}</h1>
		<div class="cards">
			<ListCard kind="to_watch" />
			<ListCard kind="watching" />
			<ListCard kind="favorites" />
			<ListCard kind="watched" />
		</div>
	</section>

	<script>
		import { initListCards } from '../../lib/lists/cards';

		document.addEventListener('astro:page-load', () => {
			if (document.querySelector('.all-lists .list-card')) initListCards();
		});
	</script>
</AppLayout>

<style>
	.all-lists {
		display: flex;
		flex-direction: column;
		gap: 16px;
		/* Mesmo respiro do topo da Home. */
		padding-top: 16px;
	}

	/* Grade pronta para mais listas: 4 colunas, 2 no tablet e 1 no mobile. */
	.cards {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;
		width: 100%;
	}

	@media (max-width: 1279px) {
		.cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 767px) {
		.cards {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
