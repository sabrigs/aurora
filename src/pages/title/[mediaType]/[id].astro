---
import AppLayout from '../../../layouts/AppLayout.astro';
import AddStatusButton from '../../../components/titles/AddStatusButton.astro';
import EpisodesSection from '../../../components/titles/EpisodesSection.astro';
import { getSeriesSeasons, type SeriesSeasons } from '../../../lib/tmdb/episodes';
import { getSameDirectorTitles, getTitleDetails, isInBrazilTheaters, type RelatedTitle, type TitleDetails } from '../../../lib/tmdb/titles';
import { cardMetaParts } from '../../../lib/tmdb/format';
import { getTitleStreamingProviders, type StreamingProvider } from '../../../lib/streaming/availability';
import { logoUrl, posterUrl } from '../../../lib/tmdb/images';
import type { MediaType } from '../../../lib/tmdb/client';

const mediaType = Astro.params.mediaType;
const id = Number(Astro.params.id);

if ((mediaType !== 'movie' && mediaType !== 'tv') || !Number.isInteger(id)) {
	return Astro.redirect('/');
}

let details: TitleDetails;
let providers: StreamingProvider[];
let inTheaters: boolean;
// Temporadas só existem para séries; se a TMDB falhar, a seção Episodes some e o resto da página segue.
let series: SeriesSeasons | null;
try {
	[details, providers, inTheaters, series] = await Promise.all([
		getTitleDetails(mediaType as MediaType, id),
		getTitleStreamingProviders(mediaType as MediaType, id).catch(() => []),
		isInBrazilTheaters(mediaType as MediaType, id).catch(() => false),
		mediaType === 'tv' ? getSeriesSeasons(id).catch(() => null) : null,
	]);
} catch {
	return Astro.redirect('/');
}

// Títulos do mesmo diretor (filme) ou criador (série). Sem diretor na TMDB, a seção some.
const related: RelatedTitle[] = details.director
	? await getSameDirectorTitles(details.mediaType, details.director.id, details.id).catch(() => [])
	: [];
const relatedHeading = details.mediaType === 'movie' ? 'From the same director' : 'From the same creator';

// Ainda não lançado: data de estreia no Brasil, ou a global, ou (sem datas) o status da TMDB.
const today = new Date().toISOString().slice(0, 10);
const releaseDate = details.brazilReleaseDate ?? details.releaseDate;
const notReleased = releaseDate
	? releaseDate > today
	: ['Planned', 'In Production', 'Post Production', 'Rumored'].includes(details.status);
const formatDate = (date: string) =>
	new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const unreleasedMessage = !releaseDate
	? 'Not released yet.'
	: details.brazilReleaseDate
		? `Not released yet. Coming to theaters in Brazil on ${formatDate(details.brazilReleaseDate)}.`
		: `Not released yet. Expected on ${formatDate(releaseDate)}.`;

const category = details.mediaType === 'movie' ? 'Movie' : 'Series';

// Série: situação na TMDB (no ar, encerrada ou cancelada) e quantidade de temporadas (sem a temporada 0).
const SERIES_STATUS: Record<string, { label: string; tone: 'ongoing' | 'ended' | 'canceled' }> = {
	'Returning Series': { label: 'Ongoing', tone: 'ongoing' },
	'In Production': { label: 'Ongoing', tone: 'ongoing' },
	Ended: { label: 'Ended', tone: 'ended' },
	Canceled: { label: 'Canceled', tone: 'canceled' },
};
const seriesStatus = details.mediaType === 'tv' ? (SERIES_STATUS[details.status] ?? null) : null;
const seasonCount = series?.seasons.length ?? 0;
const seasonsLabel = seasonCount > 0 ? `${seasonCount} ${seasonCount === 1 ? 'season' : 'seasons'}` : null;
const duration = details.runtime
	? details.runtime >= 60
		? `${Math.floor(details.runtime / 60)}h ${details.runtime % 60}min`
		: `${details.runtime}min`
	: null;
const genre = details.genres.slice(0, 2).join(', ') || null;
const rating = details.voteAverage > 0 ? `★ ${details.voteAverage.toFixed(1)}` : null;
// Cada informação vira um <span>; o espaçamento entre elas é feito por gap no CSS, como nos cards.
const metadata = [category, seasonsLabel, duration, genre, rating].filter(Boolean);

const backdrop = details.backdropPath ? `https://image.tmdb.org/t/p/w1280${details.backdropPath}` : null;
const poster = posterUrl(details.posterPath, 'w342');
---

<AppLayout fullWidth>
	<article class="title">
		<div class="hero" style={backdrop ? `--backdrop: url("${backdrop}");` : undefined}>
			<div class="hero-bar">
				<a class="back" href="/" data-back>
					<span class="back-icon" aria-hidden="true">
						<svg width="18" height="18" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</span>
					<span class="back-label">Back</span>
				</a>
			</div>

			<div class="hero-inner">
				{poster && <img class="hero-poster" src={poster} alt="" />}
				<div class="hero-text">
					{seriesStatus && (
						<span class={`status-tag status-tag--${seriesStatus.tone}`}>{seriesStatus.label}</span>
					)}
					<h1>{details.title}</h1>
					<p class="metadata">{metadata.map((part) => <span>{part}</span>)}</p>
					<AddStatusButton tmdbId={details.id} mediaType={details.mediaType} title={details.title} posterPath={details.posterPath} />
				</div>
			</div>
		</div>

		<div class="content">
			<section class="block" aria-labelledby="available-on">
				<h2 id="available-on">Available on</h2>
				{inTheaters ? (
					<ul class="providers">
						<li class="theater-chip">In theaters</li>
					</ul>
				) : providers.length > 0 ? (
					<ul class="providers">
						{providers.map((provider) => (
							<li>
								{provider.logoPath ? (
									<img src={logoUrl(provider.logoPath, 'w92') ?? ''} alt="" width="40" height="40" />
								) : null}
								<span>{provider.name}</span>
							</li>
						))}
					</ul>
				) : notReleased ? (
					<p class="unavailable">{unreleasedMessage}</p>
				) : (
					<p class="unavailable">Not available on streaming in Brazil.</p>
				)}
			</section>

			{details.overview && (
				<section class="block" aria-labelledby="about">
					<h2 id="about">About</h2>
					<p class="about">{details.overview}</p>
				</section>
			)}

			{series && series.airedEpisodeCount > 0 && (
				<EpisodesSection
					tmdbId={details.id}
					title={details.title}
					posterPath={details.posterPath}
					seasons={series.seasons.filter((season) => season.episodeCount > 0)}
					airedTotal={series.airedEpisodeCount}
					ended={series.ended}
				/>
			)}

			{details.trailers.length > 0 && (
				<section class="block" aria-labelledby="trailers">
					<h2 id="trailers">Trailers</h2>
					<ul class="trailers">
						{details.trailers.map((trailer) => (
							<li>
								<button type="button" class="trailer" data-trailer={trailer.key} data-name={trailer.name} aria-label={`Play ${trailer.name}`}>
									<img src={`https://i.ytimg.com/vi/${trailer.key}/hqdefault.jpg`} alt="" loading="lazy" />
									<span class="trailer-play" aria-hidden="true">
										<svg width="22" height="22" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
									</span>
								</button>
							</li>
						))}
					</ul>
				</section>
			)}

			{details.cast.length > 0 && (
				<section class="block" aria-labelledby="cast" data-cast data-media-type={details.mediaType} data-tmdb-id={details.id} data-total={details.castTotal}>
					<h2 id="cast">Cast</h2>
					<ul class="cast" data-cast-list>
						{details.cast.map((member) => (
							<li class="cast-member">
								<span class="cast-photo" style={member.profilePath ? `background-image: url("${posterUrl(member.profilePath, 'w185')}");` : undefined} aria-hidden="true"></span>
								<span class="cast-name">{member.name}</span>
								{member.character && <span class="cast-role">{member.character}</span>}
							</li>
						))}
					</ul>
					<button type="button" class="cast-more" data-cast-more hidden={details.castTotal <= 2}>Show all {details.castTotal}</button>
					<!-- Modelo dos membros carregados ao pedir o elenco completo (recebe o escopo de estilos da página). -->
					<template data-cast-template>
						<li class="cast-member">
							<span class="cast-photo" aria-hidden="true"></span>
							<span class="cast-name"></span>
							<span class="cast-role"></span>
						</li>
					</template>
				</section>
			)}

			{related.length > 0 && (
				<section class="block" aria-labelledby="related">
					<h2 id="related">{relatedHeading}</h2>
					<div class="related">
						{related.map((item) => (
							<article class="title-card" style={item.backdropPath || item.posterPath ? `background-image: url("${item.backdropPath ? `https://image.tmdb.org/t/p/w780${item.backdropPath}` : posterUrl(item.posterPath, 'w500')}");` : undefined}>
								<a class="title-card__cover" href={`/title/${item.mediaType}/${item.id}`} aria-label={item.title}></a>
								<div class="title-card__info">
									{item.posterPath && <img class="title-card__poster" src={posterUrl(item.posterPath, 'w185') ?? ''} alt="" />}
									<div class="title-card__text">
										<h3 class="title-card__title">{item.title}</h3>
										<p class="title-card__meta">{cardMetaParts(item).map((part) => <span>{part}</span>)}</p>
									</div>
								</div>
								<AddStatusButton tmdbId={item.id} mediaType={item.mediaType} title={item.title} posterPath={item.posterPath} />
							</article>
						))}
					</div>
				</section>
			)}
		</div>
	</article>

	<dialog id="trailer-modal" class="trailer-modal" aria-label="Trailer">
		<button type="button" class="trailer-close" aria-label="Close trailer">
			<svg width="18" height="18" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" /></svg>
		</button>
		<div class="trailer-frame"></div>
	</dialog>
</AppLayout>

<script>
	import { bindBackLink } from '../../../lib/ui/navigation';
	import { apiFetch } from '../../../lib/api';
	import { posterUrl } from '../../../lib/tmdb/images';

	// Cast: mostra só a primeira linha (a grade esconde o resto por CSS). "Show all" carrega o elenco completo.
	const setupCast = () => {
		const section = document.querySelector<HTMLElement>('[data-cast]');
		if (!section) return;
		const list = section.querySelector<HTMLElement>('[data-cast-list]')!;
		const button = section.querySelector<HTMLButtonElement>('[data-cast-more]')!;
		const template = section.querySelector<HTMLTemplateElement>('[data-cast-template]')!;
		const total = Number(section.dataset.total);

		// O botão só aparece quando há mais membros do que cabem na primeira linha.
		const updateButton = () => {
			if (list.classList.contains('is-expanded')) return;
			const hidden = [...list.children].some((member) => getComputedStyle(member).display === 'none');
			button.hidden = !hidden && total <= list.children.length;
		};
		updateButton();
		window.addEventListener('resize', updateButton);

		button.addEventListener('click', async () => {
			button.disabled = true;
			button.textContent = 'Loading…';
			try {
				// Os membros que a página já trouxe bastam quando o elenco é pequeno.
				if (total > list.children.length) {
					const response = await apiFetch(`/api/titles/${section.dataset.mediaType}/${section.dataset.tmdbId}/cast`);
					if (!response.ok) throw new Error(`cast_${response.status}`);
					const data = (await response.json()) as {
						cast: { name: string; character: string; profilePath: string | null }[];
					};

					list.replaceChildren(
						...data.cast.map((member) => {
							const item = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
							const photo = item.querySelector<HTMLElement>('.cast-photo')!;
							const src = posterUrl(member.profilePath, 'w185');
							if (src) {
								// <img> com carregamento preguiçoso: elencos grandes não baixam todas as fotos de uma vez.
								const img = document.createElement('img');
								img.src = src;
								img.alt = '';
								img.loading = 'lazy';
								img.style.cssText = 'display:block;width:100%;height:100%;object-fit:cover';
								photo.append(img);
							}
							item.querySelector('.cast-name')!.textContent = member.name;
							const role = item.querySelector<HTMLElement>('.cast-role')!;
							if (member.character) role.textContent = member.character;
							else role.remove();
							return item;
						}),
					);
				}
				list.classList.add('is-expanded');
				window.removeEventListener('resize', updateButton);
				button.remove();
			} catch (error) {
				console.error(error);
				button.disabled = false;
				button.textContent = "Couldn't load the cast. Try again";
			}
		});
	};

	// A navegação troca a página sem recarregar o script: liga o botão e o rótulo a cada visita.
	document.addEventListener('astro:page-load', () => {
		const back = document.querySelector<HTMLAnchorElement>('[data-back]');
		if (back) bindBackLink(back);

		setupCast();

		// Trailer: abre o vídeo do YouTube num overlay por cima da página.
		const modal = document.getElementById('trailer-modal') as HTMLDialogElement | null;
		if (!modal) return;
		const frame = modal.querySelector<HTMLElement>('.trailer-frame')!;

		document.querySelectorAll<HTMLButtonElement>('[data-trailer]').forEach((button) => {
			button.addEventListener('click', () => {
				const iframe = document.createElement('iframe');
				iframe.src = `https://www.youtube-nocookie.com/embed/${button.dataset.trailer}?autoplay=1&rel=0`;
				iframe.title = button.dataset.name ?? 'Trailer';
				iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
				iframe.allowFullscreen = true;
				frame.replaceChildren(iframe);
				modal.showModal();
			});
		});

		// Fecha com o botão, Esc (nativo) ou clique fora; o vídeo para ao remover o iframe.
		modal.querySelector('.trailer-close')!.addEventListener('click', () => modal.close());
		modal.addEventListener('click', (event) => {
			if (event.target === modal) modal.close();
		});
		modal.addEventListener('close', () => frame.replaceChildren());
	});
</script>

<style>
	/* Backdrop de borda a borda, logo abaixo da navbar fixa. */
	.title {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.hero {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		height: clamp(300px, 45vw, 550px);
		margin: -24px -16px 0;
		padding: 16px;
		background-color: var(--color-surface);
		background-image: var(--backdrop, none);
		background-size: cover;
		background-position: center;
	}

	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, #00000066 0%, #00000000 30%, #000000cc 100%);
		pointer-events: none;
	}

	.hero-bar {
		position: absolute;
		top: 16px;
		left: 16px;
		right: 16px;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	/* Pôster + texto alinhados à coluna de conteúdo (800px). */
	.hero-inner {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-end;
		gap: 24px;
		width: 100%;
		max-width: 800px;
		margin-inline: auto;
	}

	.hero-poster {
		flex: 0 0 auto;
		width: 160px;
		aspect-ratio: 2 / 3;
		border-radius: 4px;
		object-fit: cover;
		background-color: var(--color-surface-raised);
	}

	.hero-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 12px;
		min-width: 0;
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: var(--color-text);
		font-weight: 600;
		text-decoration: none;
	}

	.back-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 999px;
		background-color: #ffffff1a;
		backdrop-filter: blur(8px);
	}

	/* Situação da série, acima do título: bolinha colorida sobre fundo translúcido (legível em qualquer backdrop). */
	.status-tag {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-bottom: -4px;
		padding: 4px 12px;
		border-radius: 999px;
		background-color: #00000066;
		backdrop-filter: blur(8px);
		color: #fff;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.status-tag::before {
		content: '';
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background-color: var(--tag-color);
	}

	.status-tag--ongoing {
		--tag-color: #3e9b4f;
	}

	.status-tag--ended {
		--tag-color: #9ca3af;
	}

	.status-tag--canceled {
		--tag-color: #e5484d;
	}

	h1 {
		margin: 0;
		font-size: 2.25rem;
		font-weight: 700;
		color: #fff;
	}

	.metadata {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 16px;
		margin: 0;
		color: #ffffffcc;
		font-size: 1rem;
	}

	/* Conteúdo com a margem de 16px, como o restante das páginas. */
	.content {
		display: flex;
		flex-direction: column;
		gap: 32px;
		width: 100%;
		max-width: 800px;
		margin-inline: auto;
	}

	.block {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.providers {
		display: flex;
		flex-wrap: wrap;
		gap: 16px 24px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.providers li {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 1rem;
		color: var(--color-text);
	}

	.providers img {
		width: 40px;
		height: 40px;
		border-radius: 10px;
	}

	.unavailable {
		margin: 0;
		color: var(--color-text-muted);
	}

	.theater-chip {
		padding: 8px 14px;
		border-radius: 999px;
		background-color: var(--color-success-bg);
		border: 1px solid var(--color-success-border);
		color: var(--color-success-text);
		font-weight: 600;
	}

	.about {
		margin: 0;
		line-height: 1.5;
		color: var(--color-text);
	}

	.cast {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cast-member {
		display: flex;
		flex-direction: column;
		gap: 4px;
		min-width: 0;
	}

	/* Só a primeira linha da grade aparece; "Show all" remove a limitação (4 colunas; 3 e 2 abaixo). */
	.cast:not(.is-expanded) .cast-member:nth-child(n + 5) {
		display: none;
	}

	.cast-more {
		align-self: flex-start;
		height: 44px;
		padding: 0 20px;
		border: 1px solid var(--color-border-strong);
		border-radius: 999px;
		background: transparent;
		color: var(--color-text);
		font: inherit;
		font-size: 0.9375rem;
		cursor: pointer;
	}

	.cast-more:hover:not(:disabled) {
		background-color: var(--color-surface-hover);
	}

	.cast-more:disabled {
		opacity: 0.6;
		cursor: wait;
	}

	.cast-more[hidden] {
		display: none;
	}

	.cast-photo {
		display: block;
		height: 180px;
		overflow: hidden;
		border-radius: 4px;
		background-color: var(--color-surface-raised);
		background-image: linear-gradient(180deg, var(--color-surface-hover), var(--color-surface-raised));
		background-size: cover;
		background-position: center;
		margin-bottom: 8px;
	}

	.cast-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-weight: 600;
		color: var(--color-text);
	}

	.cast-role {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	.trailers {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.trailer {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		padding: 0;
		border: 0;
		border-radius: 12px;
		overflow: hidden;
		background-color: var(--color-surface-raised);
		cursor: pointer;
	}

	.trailer img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.trailer-play {
		position: absolute;
		top: 50%;
		left: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border-radius: 999px;
		transform: translate(-50%, -50%);
		background-color: #00000066;
		color: #fff;
		backdrop-filter: blur(8px);
		transition: background-color 150ms ease;
	}

	.trailer:hover .trailer-play {
		background-color: #00000099;
	}

	/* Cards do mesmo diretor: 2 colunas na coluna de 800px, 1 no mobile. */
	.related {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}

	/* Overlay do trailer, no mesmo estilo dos dropdowns (borda, raio e botão translúcido). */
	.trailer-modal {
		width: min(960px, calc(100vw - 32px));
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-text);
		overflow: visible;
	}

	.trailer-modal::backdrop {
		background: #000000b3;
		backdrop-filter: blur(4px);
	}

	.trailer-modal[open] {
		animation: trailer-in 150ms ease-out;
	}

