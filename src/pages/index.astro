---
import AppLayout from '../layouts/AppLayout.astro';
import ListCard from '../components/lists/ListCard.astro';
import ExploreFeed from '../components/explore/ExploreFeed.astro';
---

<AppLayout fullWidth requireAuth flushTop>
	<h1 class="sr-only">Home</h1>

	<div class="home">
		<section class="lists" aria-labelledby="lists-title">
			<h2 id="lists-title" class="section-title">My Lists</h2>
			<div class="cards">
				<ListCard kind="to_watch" name="To watch" />
				<ListCard kind="watching" name="Watching" />
				<ListCard kind="favorites" name="Favorites" />
				<ListCard kind="watched" name="Watched" />
			</div>
		</section>

		<ExploreFeed />
	</div>

	<script>
		import { initListCards } from '../lib/lists/cards';
		import { enableDragScroll } from '../lib/ui/drag-scroll';

		// A navegação troca a página sem recarregar o script, então a tela é montada a cada visita.
		document.addEventListener('astro:page-load', () => {
			if (document.querySelector('.home .list-card')) initListCards();
			// No mobile as listas viram um carrossel: com o mouse dá para arrastar.
			const carousel = document.querySelector<HTMLElement>('.home .cards');
			if (carousel) enableDragScroll(carousel);
		});
	</script>
</AppLayout>

<style>
	/* Listas no topo e, logo abaixo, o Explore. */
	.home {
		display: flex;
		flex-direction: column;
		gap: 32px;
		padding-top: 16px;
	}

	.lists {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* Quatro cards lado a lado ocupando toda a largura; 2 por linha no tablet. */
	.cards {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;
		width: 100%;
	}

	@media (max-width: 1279px) {
		.cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* Mobile: carrossel horizontal, para o Explore ficar perto do topo. */
	@media (max-width: 767px) {
		.cards {
			display: flex;
			gap: 12px;
			margin-inline: -16px;
			padding-inline: 16px;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: 16px;
			scrollbar-width: none;
		}

		.cards::-webkit-scrollbar {
			display: none;
		}

		/* Arrastar com o mouse (ver lib/ui/drag-scroll.ts). Durante o arraste o snap sai de cena. */
		.cards {
			cursor: grab;
		}

		.cards.is-dragging {
			cursor: grabbing;
			scroll-snap-type: none;
			user-select: none;
		}

		.cards > :global(.list-card) {
			flex: 0 0 78%;
			scroll-snap-align: start;
		}
	}
</style>
