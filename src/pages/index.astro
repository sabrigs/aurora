---
import AppLayout from '../layouts/AppLayout.astro';
import ListCard from '../components/lists/ListCard.astro';
import ExploreFeed from '../components/explore/ExploreFeed.astro';
---

<AppLayout fullWidth requireAuth>
	<h1 class="sr-only">Home</h1>

	<div class="home">
		<section class="lists" aria-label="My lists">
			<div class="cards">
				<ListCard kind="to_watch" name="To watch" />
				<ListCard kind="favorites" name="Favorites" />
				<ListCard kind="watched" name="Watched" />
			</div>
		</section>

		<ExploreFeed />
	</div>

	<script>
		import { initListCards } from '../lib/lists/cards';

		// A navegação troca a página sem recarregar o script, então a tela é montada a cada visita.
		document.addEventListener('astro:page-load', () => {
			if (document.querySelector('.home .list-card')) initListCards();
		});
	</script>
</AppLayout>

<style>
	/* Listas no topo e, logo abaixo, o Explore: a barra de abas sobe sobre as listas ao rolar. */
	.home {
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* Três cards lado a lado ocupando toda a largura. */
	.cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
		width: 100%;
	}

	/* Na Home os cards são mais baixos (250px) para o Explore aparecer mais cedo. */
	.cards > :global(.list-card) {
		box-sizing: border-box;
		height: 250px;
		/* Leque de pôsteres menor, para caber abaixo do título. */
		--poster-w: 96px;
		--poster-center-w: 120px;
		--fan-offset: 68px;
	}

	/* Mobile: carrossel horizontal, para o Explore ficar perto do topo. */
	@media (max-width: 767px) {
		.cards {
			display: flex;
			gap: 12px;
			margin-inline: -16px;
			padding-inline: 16px;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: 16px;
			scrollbar-width: none;
		}

		.cards::-webkit-scrollbar {
			display: none;
		}

		.cards > :global(.list-card) {
			flex: 0 0 78%;
			scroll-snap-align: start;
		}
	}
</style>
